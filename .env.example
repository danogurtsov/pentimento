# Model Gateway (docker-compose.yml — optional, not required for `pentimento breadth-pass`).
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=
PENTIMENTO_GATEWAY_PORT=4000

# `pentimento breadth-pass --llm <provider:model>` reads auth straight from env —
# only set the ones you actually use. See adapters/llm_factory.py for the full provider list.
CLAUDE_CODE_OAUTH_TOKEN=      # --llm anthropic:... (subscription) — or use --llm claude-cli:... instead, no token needed at all
DEEPSEEK_API_KEY=             # --llm deepseek:...
OPENAI_API_KEY=               # --llm openai:...
OPENROUTER_API_KEY=           # --llm openrouter:...
GROQ_API_KEY=                 # --llm groq:...
TOGETHER_API_KEY=             # --llm together:...
XAI_API_KEY=                  # --llm xai:...
MOONSHOT_API_KEY=             # --llm moonshot:...
